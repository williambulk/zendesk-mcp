# ============================================================================
# Zendesk MCP — Safe Sample Configuration (.env.example)
# Copy to .env (chmod 0600 .env) or ~/.config/zendesk-mcp/.env on the host.
# NEVER commit .env or tokens.json to Git.
# ============================================================================

# Target Zendesk subdomain (single DNS label, e.g. "acme" for https://acme.zendesk.com)
ZENDESK_SUBDOMAIN=your_subdomain

# OAuth Client Unique Identifier registered in Zendesk Admin Center
# (Admin Center -> Apps and integrations -> APIs -> OAuth Clients)
ZENDESK_OAUTH_CLIENT_ID=your_zendesk_oauth_client_id

# Optional OAuth Client Secret (leave blank for a public PKCE client;
# set only if using a confidential client or client_credentials grant)
ZENDESK_OAUTH_CLIENT_SECRET=

# Grant mode: "authorization_code" (recommended operator OAuth + PKCE) or "client_credentials"
ZENDESK_OAUTH_GRANT_TYPE=authorization_code

# Loopback Redirect URI registered on the Zendesk OAuth client
ZENDESK_OAUTH_REDIRECT_URI=http://127.0.0.1:18492/callback

# Narrow read-only scopes (write scopes are blocked by policy)
ZENDESK_OAUTH_SCOPES="tickets:read users:read"

# Private path where rotated OAuth tokens are persisted (0600 file inside 0700 directory)
# Defaults to ~/.config/zendesk-mcp/tokens.json if omitted
ZENDESK_TOKEN_FILE=~/.config/zendesk-mcp/tokens.json

# Optional feature toggles
ZENDESK_ENABLE_USER_TOOL=true
ZENDESK_RESOLVE_CUSTOM_FIELDS=true

# Request bounds & rate-limit resilience
ZENDESK_REQUEST_TIMEOUT_MS=15000
ZENDESK_MAX_RETRIES=3
ZENDESK_MAX_RETRY_AFTER_MS=30000
ZENDESK_MAX_CONCURRENT_REQUESTS=4
ZENDESK_MAX_BODY_CHARS=16000

# Stderr log level: debug | info | warn | error | silent
ZENDESK_LOG_LEVEL=info

# ============================================================================
# Optional Streamable HTTP Transport (leave as "stdio" for local or SSH stdio)
# ============================================================================
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3849
# Required ONLY when MCP_TRANSPORT=http (minimum 16 chars; must be distinct from Zendesk OAuth tokens)
MCP_HTTP_BEARER_TOKEN=
